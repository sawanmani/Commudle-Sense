# --- LLM extraction (optional: without a key the rule-based extractor handles EN/Hinglish/Hindi) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
LLM_EXTRACTION_ENABLED=true
LLM_COOLDOWN_SECONDS=60

# --- Database (Postgres 16 + pgvector). scripts/launch.py starts one on :5433 for you ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/commudle_safe_search

# --- Web ---
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
RATE_LIMIT_SEARCH=30/60
RATE_LIMIT_WEB_ENRICH=10/60
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=5
LOG_BLOCKED_ATTEMPTS_PATH=./logs/blocked_attempts.log

# Demo only: return the pipeline trace incl. generated SQL when the client asks (reveals schema details)
ENABLE_TRACE=false
